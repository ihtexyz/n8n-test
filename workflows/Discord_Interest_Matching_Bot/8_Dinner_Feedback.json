      "id": "c5d6e7f8-a9b0-1234-9012-feedback015",
      "name": "Sunday 10 AM - Weekly Analysis",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 1200],
      "notes": "Analyze feedback trends weekly"
    },
    {
      "parameters": {
        "operation": "list",
        "base": {
          "__rl": true,
          "value": "appXXXXXXXXXXXXXX",
          "mode": "list",
          "cachedResultName": "Discord Interest Matching"
        },
        "table": {
          "__rl": true,
          "value": "tblDinnerFeedback",
          "mode": "list",
          "cachedResultName": "Dinner_Feedback"
        },
        "filterByFormula": "=DATETIME_DIFF(NOW(), {Submitted At}, 'days') <= 7",
        "options": {
          "useFieldNames": true
        }
      },
      "id": "d6e7f8a9-b0c1-2345-0123-feedback016",
      "name": "Get Last Week Feedback",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [470, 1200],
      "credentials": {
        "airtableTokenApi": {
          "id": "2",
          "name": "Airtable Personal Access Token"
        }
      }
