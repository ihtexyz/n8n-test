    {
      "parameters": {
        "jsCode": "// Analyze dinner feedback patterns\nconst feedback = $input.all();\n\nif (feedback.length === 0) {\n  return [{ json: { message: 'No feedback this week' } }];\n}\n\n// Calculate metrics\nlet totalOverall = 0;\nlet totalGroupDynamics = 0;\nlet totalConversation = 0;\nlet totalLocation = 0;\nlet wouldAttendYes = 0;\nlet metInterestingPeople = 0;\n\nconst topicsCount = {};\nconst favoriteMoments = [];\nconst suggestions = [];\n\nfeedback.forEach(item => {\n  const fields = item.json.fields;\n  \n  // Parse ratings\n  totalOverall += parseInt(fields['Overall Rating']?.split(' ')[0]) || 0;\n  totalGroupDynamics += parseInt(fields['Group Dynamics']) || 0;\n  totalConversation += parseInt(fields['Conversation Quality']) || 0;\n  totalLocation += parseInt(fields['Location Rating']) || 0;\n  \n  if (fields['Would Attend Again']?.includes('Yes')) {\n    wouldAttendYes++;\n  }\n  \n  if (fields['Met Interesting People']) {\n    metInterestingPeople++;\n  }\n  \n  // Count topics\n  const topics = fields['Topics Discussed'] || [];\n  topics.forEach(topic => {\n    topicsCount[topic] = (topicsCount[topic] || 0) + 1;\n  });\n  \n  // Collect moments and suggestions\n  if (fields['Favorite Moments']) {\n    favoriteMoments.push(fields['Favorite Moments']);\n  }\n  if (fields['Suggestions']) {\n    suggestions.push(fields['Suggestions']);\n  }\n});\n\nconst count = feedback.length;\nconst avgOverall = (totalOverall / count).toFixed(2);\nconst avgGroupDynamics = (totalGroupDynamics / count).toFixed(2);\nconst avgConversation = (totalConversation / count).toFixed(2);\nconst avgLocation = (totalLocation / count).toFixed(2);\nconst attendAgainRate = ((wouldAttendYes / count) * 100).toFixed(1);\nconst connectionRate = ((metInterestingPeople / count) * 100).toFixed(1);\n\nconst popularTopics = Object.entries(topicsCount)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(([topic, count]) => ({ topic, count }));\n\nreturn [{\n  json: {\n    weekOf: new Date().toISOString().split('T')[0],\n    totalFeedback: count,\n    averages: {\n      overall: avgOverall,\n      groupDynamics: avgGroupDynamics,\n      conversation: avgConversation,\n      location: avgLocation\n    },\n    rates: {\n      wouldAttendAgain: attendAgainRate,\n      madeConnections: connectionRate\n    },\n    popularTopics: popularTopics,\n    highlights: favoriteMoments.slice(0, 3),\n    suggestionsForImprovement: suggestions.slice(0, 5)\n  }\n}];"
      },
      "id": "e7f8a9b0-c1d2-3456-1234-feedback017",
      "name": "Analyze Feedback Patterns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 1200]
    },
    {
      "parameters": {
        "content": "=📊 **Weekly Dinner Feedback Report**\n\n**Week of**: {{ $json.weekOf }}\n**Total Responses**: {{ $json.totalFeedback }}\n\n**Average Ratings** (out of 5):\n• Overall Experience: {{ $json.averages.overall }}\n• Group Dynamics: {{ $json.averages.groupDynamics }}\n• Conversation Quality: {{ $json.averages.conversation }}\n• Location: {{ $json.averages.location }}\n\n**Engagement**:\n• Would Attend Again: {{ $json.rates.wouldAttendAgain }}%\n• Made Connections: {{ $json.rates.madeConnections }}%\n\n**Popular Topics**:\n{{ $json.popularTopics.map(t => `• ${t.topic}: ${t.count} mentions`).join('\\n') }}\n\n**Highlights**:\n{{ $json.highlights.map(h => `• \"${h}\"`).join('\\n') }}\n\n**Suggestions for Next Week**:\n{{ $json.suggestionsForImprovement.map(s => `• ${s}`).join('\\n') }}",
        "channel": "admin-channel",
        "additionalFields": {}
      },
