    {
      "parameters": {
        "jsCode": "// Analyze feedback patterns and update matching algorithm weights\nconst allFeedback = $input.all();\n\nif (allFeedback.length === 0) {\n  return [];\n}\n\n// Calculate aggregate statistics\nlet totalRating = 0;\nlet totalConvQuality = 0;\nlet wouldMeetAgainYes = 0;\nlet topicsCount = {};\nlet totalResponses = allFeedback.length;\n\nallFeedback.forEach(item => {\n  const fields = item.json.fields;\n  \n  // Parse ratings\n  const rating = parseInt(fields['Rating']?.split(' ')[0]) || 0;\n  const convQuality = parseInt(fields['Conversation Quality']) || 0;\n  \n  totalRating += rating;\n  totalConvQuality += convQuality;\n  \n  if (fields['Would Meet Again'] === 'Yes') {\n    wouldMeetAgainYes++;\n  }\n  \n  // Count topics\n  const topics = fields['Topics Discussed'] || [];\n  topics.forEach(topic => {\n    topicsCount[topic] = (topicsCount[topic] || 0) + 1;\n  });\n});\n\n// Calculate algorithm adjustment recommendations\nconst avgRating = totalRating / totalResponses;\nconst avgConvQuality = totalConvQuality / totalResponses;\nconst meetAgainRate = (wouldMeetAgainYes / totalResponses) * 100;\n\nconst recommendations = {\n  averageRating: avgRating.toFixed(2),\n  averageConversationQuality: avgConvQuality.toFixed(2),\n  meetAgainPercentage: meetAgainRate.toFixed(1),\n  popularTopics: Object.entries(topicsCount)\n    .sort((a, b) => b[1] - a[1])\n    .slice(0, 5)\n    .map(([topic, count]) => ({ topic, count })),\n  algorithmSuggestions: []\n};\n\n// Generate suggestions based on metrics\nif (avgRating < 3.5) {\n  recommendations.algorithmSuggestions.push('Increase weight on shared interests (currently 40%)');\n}\n\nif (avgConvQuality >= 4.0) {\n  recommendations.algorithmSuggestions.push('Current matching criteria working well - maintain');\n}\n\nif (meetAgainRate < 60) {\n  recommendations.algorithmSuggestions.push('Consider adding personality matching or communication style');\n}\n\nreturn [{ json: recommendations }];"
      },
