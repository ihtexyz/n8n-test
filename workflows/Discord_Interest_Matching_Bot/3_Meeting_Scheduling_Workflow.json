    {
      "parameters": {
        "jsCode": "// Merge user data for Cal.com event creation\nconst matchData = $('Get Match Details').item.json;\nconst user1 = $('Get User 1 Details').item.json.fields;\nconst user2 = $('Get User 2 Details').item.json.fields;\n\nreturn [{\n  json: {\n    match_id: matchData.id,\n    match_score: matchData.fields['Match Score'],\n    match_reason: matchData.fields['Match Reason'],\n    user1: {\n      id: $('Get User 1 Details').item.json.id,\n      name: user1['Full Name'],\n      email: user1['Email'],\n      discord_id: user1['Discord ID'],\n      timezone: user1['Timezone']\n    },\n    user2: {\n      id: $('Get User 2 Details').item.json.id,\n      name: user2['Full Name'],\n      email: user2['Email'],\n      discord_id: user2['Discord ID'],\n      timezone: user2['Timezone']\n    },\n    event_title: `Interest Match: ${user1['Full Name']} & ${user2['Full Name']}`,\n    event_description: `Matched by Interest Matching Bot\\n\\nMatch Score: ${matchData.fields['Match Score']}/100\\n\\nWhy you matched:\\n${matchData.fields['Match Reason']}\\n\\nDiscussion topics: Career, hobbies, potential collaborations`\n  }\n}];"
      },
      "id": "e5f6a7b8-c9d0-1234-ef12-scheduling005",
      "name": "Prepare Event Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "resource": "event-type",
        "operation": "create",
        "eventTypeData": {
          "title": "={{ $json.event_title }}",
          "slug": "interest-match-{{ $json.match_id }}",
          "length": 60,
          "description": "={{ $json.event_description }}",
          "locations": [
            {
              "type": "integrations:zoom",
              "displayLocationPublicly": true
            }
          ],
          "minimumBookingNotice": 60,
          "beforeEventBuffer": 0,
          "afterEventBuffer": 0,
          "requiresConfirmation": false
        },
        "additionalFields": {
          "hosts": ["={{ $json.user1.email }}", "={{ $json.user2.email }}"],
          "schedulingType": "COLLECTIVE"
        }
      },
      "id": "f6a7b8c9-d0e1-2345-f123-scheduling006",
      "name": "Create Cal.com Event Type",
      "type": "n8n-nodes-base.cal",
      "typeVersion": 1,
