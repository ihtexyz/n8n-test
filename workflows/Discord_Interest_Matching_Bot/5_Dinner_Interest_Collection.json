    },
    {
      "parameters": {
        "channel": "={{ $json.fields['Discord ID'] }}",
        "embeds": [
          {
            "title": "✅ You're on the list!",
            "description": "=Thanks for signing up, {{ $json.fields['Full Name'].split(' ')[0] }}!",
            "color": 5763719,
            "fields": [
              {
                "name": "📅 Your Preferences",
                "value": "=**Day**: {{ $('Create RSVP in Airtable').item.json.fields['Preferred Day'] }}\\n**Areas**: {{ $('Create RSVP in Airtable').item.json.fields['Preferred Areas'].join(', ') }}",
                "inline": false
              },
              {
                "name": "⏰ What's Next",
                "value": "• **Tuesday evening**: We'll assign you to a group\\n• **Wednesday/Thursday**: You'll get dinner details (location, time, who's coming)\\n• **Day before**: Final reminder\\n• **After dinner**: Quick feedback survey",
                "inline": false
              },
              {
                "name": "🎯 Tips",
                "value": "• Come with an open mind\\n• Be curious about others\\n• Share your story\\n• Exchange contacts if you connect!",
                "inline": false
              }
            ],
            "footer": {
              "text": "Need to change your RSVP? Just submit the form again or DM us"
            }
          }
        ]
      },
      "id": "c9d0e1f2-a3b4-5678-3456-dinner009",
      "name": "Send RSVP Confirmation",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [910, 700],
      "credentials": {
        "discordApi": {
          "id": "1",
          "name": "Discord Bot Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"RSVP recorded! Check your Discord DM for confirmation.\", \"rsvp_id\": $('Create RSVP in Airtable').item.json.id } }}",
        "options": {}
      },
      "id": "d0e1f2a3-b4c5-6789-4567-dinner010",
