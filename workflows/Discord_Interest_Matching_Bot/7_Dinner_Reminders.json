    {
      "parameters": {
        "jsCode": "// Assign location based on group preferences\nconst event = $input.item(0).json;\nconst attendees = event.fields['Attendees'] || [];\n\n// Get attendee details from RSVPs\nconst areas = [];\nconst dietaryNeeds = [];\n\n// For now, use a simple location assignment\n// In production, you'd query RSVPs and pick best location\nconst locations = [\n  {\n    name: \"Pizzeria Delfina\",\n    address: \"3611 18th St, San Francisco, CA 94110\",\n    area: \"Mission\",\n    mapLink: \"https://maps.google.com/?q=Pizzeria+Delfina+Mission\",\n    cuisine: \"Italian\"\n  },\n  {\n    name: \"State Bird Provisions\",\n    address: \"1529 Fillmore St, San Francisco, CA 94115\",\n    area: \"Western Addition\",\n    mapLink: \"https://maps.google.com/?q=State+Bird+Provisions\",\n    cuisine: \"American\"\n  },\n  {\n    name: \"Nopa\",\n    address: \"560 Divisadero St, San Francisco, CA 94117\",\n    area: \"Alamo Square\",\n    mapLink: \"https://maps.google.com/?q=Nopa+SF\",\n    cuisine: \"California\"\n  }\n];\n\n// Pick a random location for now\nconst location = locations[Math.floor(Math.random() * locations.length)];\n\nreturn [{\n  json: {\n    eventId: event.id,\n    day: event.fields['Day'],\n    date: event.fields['Date'],\n    time: event.fields['Time'],\n    groupSize: event.fields['Group Size'],\n    attendees: attendees,\n    location: location\n  }\n}];"
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-remind003",
      "name": "Assign Location",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300],
      "notes": "Simple location assignment - can be enhanced"
    },
    {
