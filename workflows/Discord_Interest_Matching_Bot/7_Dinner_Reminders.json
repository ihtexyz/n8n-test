      },
      "id": "a1b2c3d4-e5f6-7890-abcd-remind001",
      "name": "Tuesday & Wednesday 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300],
      "notes": "Tuesday for Wednesday dinners, Wednesday for Thursday dinners"
    },
    {
      "parameters": {
        "operation": "list",
        "base": {
          "__rl": true,
          "value": "appXXXXXXXXXXXXXX",
          "mode": "list",
          "cachedResultName": "Discord Interest Matching"
        },
        "table": {
          "__rl": true,
          "value": "tblDinnerEvents",
          "mode": "list",
          "cachedResultName": "Dinner_Events"
        },
        "filterByFormula": "=AND({Status}='Planning', OR({Day}='Wednesday', {Day}='Thursday'), DATETIME_DIFF({Date}, TODAY(), 'days') = 1)",
        "options": {
          "useFieldNames": true
        }
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-remind002",
      "name": "Get Tomorrow's Dinners",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [470, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "2",
          "name": "Airtable Personal Access Token"
        }
      }
